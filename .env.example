# =============================================================================
# SE Copilot — environment variables. Copy to .env and fill in. NEVER commit .env.
# Both apps/web and apps/worker read this file from the repo root.
# =============================================================================

# --- Database (Postgres also hosts the pg-boss job queue, schema "pgboss") ---
DATABASE_URL="postgresql://se_copilot:se_copilot@localhost:5432/se_copilot"

# --- App / auth ---
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""
# AES-256-GCM key for secrets at rest (OAuth tokens, passcodes). openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Microsoft 365 / Entra ID (one app registration) ---
# Used for: Microsoft sign-in (delegated), reading the team calendar and
# sending customer email as the Team DL (application permissions:
# Calendars.Read, Mail.Send, Mail.ReadBasic). Scope it to the team mailboxes
# with an Exchange Application Access Policy — see docs/setup/microsoft-365.md.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Team bootstrap (used once by `npm run db:seed`; then edit in Settings → Team) ---
TEAM_NAME="Solution Engineering"
# The DL customer follow-ups appear to come from
TEAM_DL=""
TEAM_DL_DISPLAY_NAME="Solution Engineering Team"
# Licensed/shared mailbox Graph sends through (needs Send As on TEAM_DL if different)
EMAIL_SENDER_MAILBOX=""
# Shared mailbox whose calendar receives the team's meeting invites
TEAM_MEETING_SOURCE_MAILBOX=""
# Comma-separated; everyone else is treated as a customer
INTERNAL_DOMAINS="example.com"
TEAM_TIMEZONE="UTC"

# --- Email provider ---
# "graph" (default) sends through Microsoft Graph.
# "dev-outbox" records emails without delivering them — local development only, refused in production.
EMAIL_PROVIDER="graph"
# App notification emails to SEs (optional; Resend)
EMAIL_FROM="SE Copilot <notifications@example.com>"
RESEND_API_KEY=""

# --- AI notetaker: Recall.ai (Zoom + Microsoft Teams bots) ---
RECALL_API_KEY=""
# Your workspace region base URL
RECALL_API_BASE_URL="https://us-east-1.recall.ai"
# Webhook signing secret (whsec_...). Point Recall's webhook at <NEXTAUTH_URL>/api/webhooks/recall
RECALL_WEBHOOK_SECRET=""
# meeting_captions (no extra cost, needs captions enabled) | recallai_streaming (billed, works without captions)
RECALL_TRANSCRIPT_PROVIDER="meeting_captions"

# --- AI analysis (Anthropic Claude) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- Calendar polling (cron, worker timezone) ---
CALENDAR_SYNC_CRON="*/5 * * * *"

# --- Optional: Zoom cloud-recording fallback (meetings hosted in YOUR Zoom account) ---
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_WEBHOOK_SECRET_TOKEN=""
TRANSCRIPTION_PROVIDER="openai"
OPENAI_API_KEY=""

# --- Object storage for downloaded Zoom recordings (S3-compatible) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="se-copilot"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="true"

NODE_ENV="development"
LOG_LEVEL="info"
