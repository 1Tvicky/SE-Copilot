generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  /// A Solution / Presales Engineer.
  USER
  /// Presales manager / team lead: sees every meeting in the team.
  MANAGER
  ADMIN
}

enum MeetingPlatform {
  ZOOM
  TEAMS
  OTHER
  UNKNOWN
}

enum MeetingType {
  CUSTOMER_DISCOVERY
  TECHNICAL_DISCUSSION
  DEMO
  POC
  MIGRATION_DISCUSSION
  ARCHITECTURE_DISCUSSION
  PRESALES
  INTERNAL
  OTHER
}

/// Where a meeting row came from.
enum MeetingOrigin {
  CALENDAR
  MANUAL
}

enum CaptureMode {
  /// Platform transcript only (bot or native transcript).
  TRANSCRIPT
  /// SE notes only.
  MANUAL_NOTES
  /// Transcript + SE notes (preferred).
  TRANSCRIPT_AND_NOTES
}

enum TeamMeetingSourceType {
  SHARED_MAILBOX
  GROUP_CALENDAR
  DELEGATED_CALENDAR
  /// Invites forwarded to a team mailbox; read from that mailbox calendar.
  FORWARDED_MAILBOX
}

enum ParticipantRole {
  ORGANIZER
  REQUIRED
  OPTIONAL
  RESOURCE
}

enum BotSessionStatus {
  SCHEDULED
  JOINING
  WAITING_FOR_ADMISSION
  JOINED
  CAPTURING
  CALL_ENDED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TranscriptSource {
  /// Speech-to-text of a downloaded recording (Zoom cloud recording + Whisper).
  RECORDING_TRANSCRIPTION
  /// Transcript captured by the AI notetaker bot.
  MEETING_BOT
  UPLOADED_FILE
  PASTED_TEXT
}

enum NoteCategory {
  GENERAL
  REQUIREMENT
  QUESTION
  ANSWER
  DECISION
  ACTION_ITEM
  IMPORTANT
  FOLLOW_UP
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MomStatus {
  /// Generated by AI, not yet reviewed.
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
}

enum EmailKind {
  CUSTOMER_MOM
}

enum EmailStatus {
  /// Prepared from an approved MOM; the SE has not confirmed the send yet.
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ApprovalContentType {
  MOM
  CUSTOMER_EMAIL
}

enum ApprovalAction {
  AI_GENERATED
  REGENERATED
  EDITED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  REJECTED
  EMAIL_PREPARED
  SEND_CONFIRMED
  SENT
  SEND_FAILED
}

enum ParticipantType {
  AUTHORIZED_GUEST
  AUTHENTICATED_ACCOUNT
}

enum RecordingPreference {
  NONE
  CLOUD_RECORDING_IF_AVAILABLE
}

enum MeetingSessionStatus {
  DRAFT
  SCHEDULED
  PREPARING
  JOINING
  WAITING_FOR_ADMISSION
  ACTIVE
  RECORDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum EventSource {
  SYSTEM
  WEBHOOK
  USER
  WORKER
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum RecordingFileType {
  VIDEO
  AUDIO
  CHAT
  TRANSCRIPT_VTT
}

enum RecordingStatus {
  PENDING
  AVAILABLE
  FAILED
  DELETED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SummaryStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum NotificationType {
  MEETING_SCHEDULED
  MEETING_STARTING
  JOIN_SUCCEEDED
  MEETING_COMPLETED
  MEETING_FAILED
  RECORDING_READY
  TRANSCRIPT_READY
  SUMMARY_READY
  BOT_JOINED
  BOT_FAILED
  ANALYSIS_READY
  MOM_READY
  APPROVAL_REQUIRED
  EMAIL_SENT
  EMAIL_FAILED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String? // null when the account is OAuth-only
  role              Role      @default(USER)
  teamId            String?
  timezone          String    @default("UTC")
  emailSignature    String?   @db.Text
  notificationPrefs Json      @default("{}")
  /// Bumped on "log out of all sessions" and password change; embedded in issued JWTs
  /// so tokens minted before the bump stop validating even though sessions are stateless.
  tokenVersion      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  accounts            Account[]
  sessions            UserSession[]
  meetingCredentials  MeetingCredential[]
  meetingSessions     MeetingSession[]
  mediaAssets         MediaAsset[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  backupForMeetings   MeetingSession[]     @relation("BackupSe")
  meetingNotes        MeetingNote[]
  approvalEvents      ApprovalEvent[]

  @@index([teamId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Our own audit trail of issued JWT sessions (NextAuth uses the "jwt" strategy, required
/// for the Credentials provider, so it never persists sessions itself). One row is written
/// per sign-in and carries a hash of the JWT's `sessionId` claim, letting a user or admin see
/// and revoke individual sessions, and letting "log out of all sessions" mark every row revoked.
model UserSession {
  id            String    @id @default(uuid())
  userId        String
  sessionIdHash String    @unique
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Meeting provider registry & credentials
// ---------------------------------------------------------------------------

model MeetingProviderRecord {
  id               String          @id @default(uuid())
  platform         MeetingPlatform @unique
  displayName      String
  isEnabled        Boolean         @default(true)
  capabilitiesJson Json
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  meetingSessions MeetingSession[]

  @@map("meeting_providers")
}

model MeetingCredential {
  id                    String          @id @default(uuid())
  userId                String
  platform              MeetingPlatform
  accessTokenEncrypted  String          @db.Text
  refreshTokenEncrypted String?         @db.Text
  scope                 String?
  externalAccountId     String?
  expiresAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("meeting_credentials")
}

// ---------------------------------------------------------------------------
// Meeting sessions
// ---------------------------------------------------------------------------

model MeetingSession {
  id                     String               @id @default(uuid())
  /// The assigned SE (meeting owner inside SE Copilot).
  userId                 String
  backupSeUserId         String?
  teamId                 String?
  providerId             String?
  customerId             String?
  sourceId               String?
  origin                 MeetingOrigin        @default(MANUAL)
  /// Calendar event id within the source mailbox/calendar (Graph event id).
  externalEventId        String?
  iCalUId                String?
  calendarLastModifiedAt DateTime?
  name                   String
  description            String?              @db.Text
  organizerEmail         String?
  organizerName          String?
  platform               MeetingPlatform
  meetingUrl             String?
  meetingId              String?
  passcodeEncrypted      String?
  participantDisplayName String               @default("SE Copilot Notetaker")
  participantType        ParticipantType      @default(AUTHORIZED_GUEST)
  scheduledAt            DateTime
  endsAt                 DateTime?
  timezone               String               @default("UTC")
  maxDurationMinutes     Int                  @default(60)
  meetingType            MeetingType          @default(OTHER)
  meetingTypeOverridden  Boolean              @default(false)
  captureMode            CaptureMode          @default(TRANSCRIPT_AND_NOTES)
  /// Result of the eligibility rules at last evaluation.
  botEligible            Boolean              @default(false)
  botIneligibleReason    String?
  /// null = follow the rules; true/false = SE override.
  botOverride            Boolean?
  recordingPreference    RecordingPreference  @default(CLOUD_RECORDING_IF_AVAILABLE)
  transcriptEnabled      Boolean              @default(true)
  summaryEnabled         Boolean              @default(true)
  notifyOnStatusChange   Boolean              @default(true)
  status                 MeetingSessionStatus @default(DRAFT)
  externalMeetingUuid    String?
  startedAt              DateTime?
  endedAt                DateTime?
  failureReason          String?
  cancelledAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupSe User?                  @relation("BackupSe", fields: [backupSeUserId], references: [id], onDelete: SetNull)
  provider MeetingProviderRecord? @relation(fields: [providerId], references: [id])
  team     Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  customer Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source   TeamMeetingSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  participants   MeetingParticipant[]
  botSessions    MeetingBotSession[]
  notes          MeetingNote[]
  analyses       MeetingAnalysis[]
  mom            Mom?
  actionItems    ActionItem[]
  emailMessages  EmailMessage[]
  events         MeetingSessionEvent[]
  mediaAssets    MediaAsset[]
  recordings     Recording[]
  transcripts    Transcript[]
  summaries      MeetingSummary[]
  backgroundJobs BackgroundJob[]
  notifications  Notification[]

  @@unique([sourceId, externalEventId])
  @@index([userId])
  @@index([teamId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("meeting_sessions")
}

model MeetingSessionEvent {
  id               String               @id @default(uuid())
  meetingSessionId String
  fromStatus       MeetingSessionStatus
  toStatus         MeetingSessionStatus
  source           EventSource
  message          String?
  metadataJson     Json?
  idempotencyKey   String?
  occurredAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)

  @@unique([meetingSessionId, idempotencyKey])
  @@index([meetingSessionId])
  @@map("meeting_session_events")
}

// ---------------------------------------------------------------------------
// Media, recordings, transcripts, summaries
// ---------------------------------------------------------------------------

model MediaAsset {
  id               String           @id @default(uuid())
  userId           String
  meetingSessionId String?
  fileName         String
  mimeType         String
  fileSizeBytes    Int
  durationSeconds  Float?
  storageKey       String
  status           MediaAssetStatus @default(UPLOADING)
  failureReason    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingSession MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([meetingSessionId])
  @@map("media_assets")
}

model Recording {
  id                  String            @id @default(uuid())
  meetingSessionId    String
  fileType            RecordingFileType
  storageKey          String?
  fileSizeBytes       Int?
  durationSeconds     Float?
  status              RecordingStatus   @default(PENDING)
  externalRecordingId String?           @unique
  isPrivate           Boolean           @default(true)
  failureReason       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  transcripts    Transcript[]

  @@index([meetingSessionId])
  @@map("recordings")
}

model Transcript {
  id               String           @id @default(uuid())
  meetingSessionId String
  recordingId      String?
  source           TranscriptSource @default(RECORDING_TRANSCRIPTION)
  status           TranscriptStatus @default(PENDING)
  provider         String?
  language         String?
  failureReason    String?
  generatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  meetingSession MeetingSession      @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  recording      Recording?          @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  segments       TranscriptSegment[]
  summaries      MeetingSummary[]

  @@index([meetingSessionId])
  @@map("transcripts")
}

model TranscriptSegment {
  id           String   @id @default(uuid())
  transcriptId String
  speakerLabel String?
  startMs      Int
  endMs        Int
  text         String   @db.Text
  createdAt    DateTime @default(now())

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

model MeetingSummary {
  id                String        @id @default(uuid())
  meetingSessionId  String
  transcriptId      String?
  status            SummaryStatus @default(PENDING)
  overview          String?       @db.Text
  topicsJson        Json?
  decisionsJson     Json?
  actionItemsJson   Json?
  questionsJson     Json?
  keyTimestampsJson Json?
  participantsJson  Json?
  model             String?
  failureReason     String?
  generatedAt       DateTime?
  isEdited          Boolean       @default(false)
  editedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  transcript     Transcript?    @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  @@index([meetingSessionId])
  @@map("meeting_summaries")
}

// ---------------------------------------------------------------------------
// Jobs, notifications, audit
// ---------------------------------------------------------------------------

model BackgroundJob {
  id               String    @id @default(uuid())
  meetingSessionId String?
  queueName        String
  jobId            String
  jobType          String
  status           JobStatus @default(WAITING)
  attemptsMade     Int       @default(0)
  maxAttempts      Int       @default(3)
  lastError        String?
  scheduledFor     DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  meetingSession MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: SetNull)

  @@unique([queueName, jobId])
  @@index([status])
  @@index([meetingSessionId])
  @@map("background_jobs")
}

model Notification {
  id               String              @id @default(uuid())
  userId           String
  meetingSessionId String?
  type             NotificationType
  channel          NotificationChannel @default(EMAIL)
  subject          String
  body             String              @db.Text
  status           NotificationStatus  @default(PENDING)
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime            @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingSession MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  targetType   String?
  targetId     String?
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// SE Copilot: team, meeting sources, customers
// ---------------------------------------------------------------------------

/// A Solution Engineering team: who customer follow-ups are sent as, and the
/// notetaker rules.
model Team {
  id                   String        @id @default(uuid())
  name                 String
  /// The address customer follow-ups appear to come FROM (e.g. the team DL).
  teamDlAddress        String?
  teamDlDisplayName    String?
  /// The licensed mailbox SE Copilot calls Graph as (POST /users/{this}/sendMail).
  /// Needs "Send As" on teamDlAddress when the two differ.
  senderMailbox        String?
  emailSignature       String?       @db.Text
  /// Domains considered internal; attendees from any other domain are treated as customers.
  internalDomains      String[]      @default([])
  timezone             String        @default("UTC")
  botEnabled           Boolean       @default(true)
  botDisplayName       String        @default("SE Copilot Notetaker")
  /// Minutes before scheduled start the bot should join (1, 2 or 5).
  botJoinOffsetMinutes Int           @default(1)
  botEligibleTypes     MeetingType[] @default([CUSTOMER_DISCOVERY, TECHNICAL_DISCUSSION, DEMO, POC, MIGRATION_DISCUSSION, ARCHITECTURE_DISCUSSION, PRESALES])
  /// Case-insensitive markers in subject/body that opt a meeting out of the notetaker.
  noAiMarkers          String[]      @default(["no ai", "no-ai", "#noai", "no recording", "no notetaker"])
  /// Chat message the bot posts when it joins, for transparency.
  botJoinMessage       String        @default("Hi all - SE Copilot Notetaker (an AI assistant) has joined to transcribe this meeting for the Solution Engineering team's notes. Let us know if you would prefer it to leave.")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users         User[]
  sources       TeamMeetingSource[]
  customers     Customer[]
  meetings      MeetingSession[]
  emailMessages EmailMessage[]

  @@map("teams")
}

/// Where SE Copilot discovers the team's customer meetings. A DL has no
/// calendar of its own, so this always points at something that does: a shared
/// mailbox the DL delivers to, a Microsoft 365 group calendar, a delegated user
/// calendar, or a mailbox invites are forwarded to.
model TeamMeetingSource {
  id                 String                @id @default(uuid())
  teamId             String
  type               TeamMeetingSourceType
  displayName        String
  /// UPN/SMTP address of the mailbox (SHARED_MAILBOX / DELEGATED_CALENDAR / FORWARDED_MAILBOX).
  mailboxAddress     String?
  /// Microsoft 365 group id (GROUP_CALENDAR).
  groupId            String?
  isEnabled          Boolean               @default(true)
  syncDaysAhead      Int                   @default(14)
  lastSyncedAt       DateTime?
  lastSyncStatus     String?
  lastSyncError      String?
  lastSyncEventCount Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  meetings MeetingSession[]

  @@index([teamId])
  @@map("team_meeting_sources")
}

model Customer {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  /// Email domains that identify this customer's participants.
  domains   String[] @default([])
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  meetings    MeetingSession[]
  actionItems ActionItem[]

  @@index([teamId])
  @@map("customers")
}

model MeetingParticipant {
  id               String          @id @default(uuid())
  meetingSessionId String
  email            String
  name             String?
  role             ParticipantRole @default(REQUIRED)
  isExternal       Boolean         @default(false)
  responseStatus   String?
  createdAt        DateTime        @default(now())

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)

  @@unique([meetingSessionId, email])
  @@map("meeting_participants")
}

// ---------------------------------------------------------------------------
// SE Copilot: notetaker bot, notes, analysis, MOM
// ---------------------------------------------------------------------------

model MeetingBotSession {
  id                String           @id @default(uuid())
  meetingSessionId  String
  /// Bot provider key, e.g. "recall".
  provider          String
  externalBotId     String?          @unique
  status            BotSessionStatus @default(SCHEDULED)
  botName           String
  joinAt            DateTime?
  /// Last raw status code / sub_code reported by the provider.
  lastStatusCode    String?
  lastSubCode       String?
  lastEventAt       DateTime?
  joinedAt          DateTime?
  leftAt            DateTime?
  failureReason     String?
  transcriptReadyAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)

  @@index([meetingSessionId])
  @@index([status])
  @@map("meeting_bot_sessions")
}

model MeetingNote {
  id               String       @id @default(uuid())
  meetingSessionId String
  authorUserId     String?
  category         NoteCategory @default(GENERAL)
  text             String       @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  author         User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([meetingSessionId, createdAt])
  @@map("meeting_notes")
}

/// Structured AI meeting intelligence. contentJson follows the
/// MeetingAnalysisContent schema in @meeting-assistant/shared.
model MeetingAnalysis {
  id               String         @id @default(uuid())
  meetingSessionId String
  status           AnalysisStatus @default(PENDING)
  contentJson      Json?
  /// Which inputs were available, e.g. { transcriptSegments, notes, previousMeetings }.
  inputsJson       Json?
  model            String?
  failureReason    String?
  generatedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)

  @@index([meetingSessionId, createdAt])
  @@map("meeting_analyses")
}

/// Customer-facing Minutes of Meeting, one per meeting. Regenerating replaces
/// the content and resets the review state.
model Mom {
  id               String    @id @default(uuid())
  meetingSessionId String    @unique
  analysisId       String?
  status           MomStatus @default(DRAFT)
  /// Exactly what was generated (kept for the audit trail).
  aiMarkdown       String    @db.Text
  /// The current, possibly SE-edited, content.
  markdown         String    @db.Text
  /// sha256 of `markdown` when approved. Sending requires it to still match.
  approvedHash     String?
  version          Int       @default(1)
  generatedAt      DateTime  @default(now())
  editedAt         DateTime?
  editedById       String?
  approvedAt       DateTime?
  approvedById     String?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionReason  String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  emailMessages  EmailMessage[]

  @@index([status])
  @@map("moms")
}

model ActionItem {
  id               String             @id @default(uuid())
  meetingSessionId String
  customerId       String?
  description      String             @db.Text
  owner            String?
  /// Only set when the meeting stated an explicit calendar date.
  dueDate          DateTime?
  /// The due date as stated in the meeting ("next Friday"), or null.
  dueDateText      String?
  priority         ActionItemPriority @default(MEDIUM)
  status           ActionItemStatus   @default(OPEN)
  /// "ai" or "manual".
  origin           String             @default("ai")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  meetingSession MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([meetingSessionId])
  @@index([status])
  @@map("action_items")
}

// ---------------------------------------------------------------------------
// SE Copilot: outbound email + approval audit
// ---------------------------------------------------------------------------

model EmailMessage {
  id                String      @id @default(uuid())
  teamId            String?
  meetingSessionId  String?
  momId             String?
  kind              EmailKind
  status            EmailStatus @default(DRAFT)
  fromAddress       String
  fromName          String?
  /// Mailbox Graph is called as.
  senderMailbox     String
  toJson            Json
  ccJson            Json        @default("[]")
  subject           String
  bodyHtml          String      @db.Text
  bodyText          String      @db.Text
  /// sha256 of the MOM markdown this email was built from.
  momHash           String?
  validationJson    Json?
  /// Graph id of the original invitation message, when found, for threading.
  replyToMessageId  String?
  providerMessageId String?
  confirmedAt       DateTime?
  confirmedById     String?
  sentAt            DateTime?
  failureReason     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  meetingSession MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: SetNull)
  mom            Mom?            @relation(fields: [momId], references: [id], onDelete: SetNull)

  @@index([meetingSessionId])
  @@index([status])
  @@map("email_messages")
}

/// Append-only approval trail: every generation, edit, approval, rejection and
/// send of external content, with a snapshot of the content at that moment.
model ApprovalEvent {
  id               String              @id @default(uuid())
  contentType      ApprovalContentType
  contentId        String
  meetingSessionId String?
  action           ApprovalAction
  actorUserId      String?
  snapshot         String?             @db.Text
  metadataJson     Json?
  createdAt        DateTime            @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId, createdAt])
  @@index([meetingSessionId])
  @@map("approval_events")
}

// ---------------------------------------------------------------------------
// Infra tables that replaced Redis
// ---------------------------------------------------------------------------

/// Fixed-window rate limit counters (previously Redis INCR/EXPIRE).
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// Worker liveness, refreshed every 10s (previously TTL'd Redis keys).
model WorkerHeartbeat {
  workerId   String   @id
  pid        Int
  startedAt  DateTime
  lastBeatAt DateTime

  @@map("worker_heartbeats")
}
